# Database: SQLite Lokal (default: file:./data/openlynk.db) atau Turso Cloud (libsql://...)
# PRODUCTION WAJIB: gunakan Turso (libsql://...) + DATABASE_AUTH_TOKEN agar data tidak hilang saat redeploy.
# Catatan: di production TIDAK ada seed otomatis (user/page/demo tidak dibuat) — register sendiri.
# Override darurat: SEED_DEMO_USER=true (isi data demo meski production).
DATABASE_URL=
DATABASE_AUTH_TOKEN=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_URL=http://localhost:3000
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=OpenLynk <noreply@openlynk.id>
# PRODUCTION WAJIB: set random 32+ char untuk proteksi endpoint admin & klaim page legacy.
ADMIN_TOKEN=

# ImageKit Cloud Storage Configuration
# PRODUCTION WAJIB: tanpa ini upload akan ditolak (filesystem serverless ephemeral).
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# WhatsApp Transactional Gateway (Fonnte / Wablas / Webhook)
FONNTE_TOKEN=
WABLAS_TOKEN=
WABLAS_DOMAIN=https://kudus.wablas.com
WHATSAPP_WEBHOOK_URL=

# Login dengan Google (opsional — tombol disembunyikan bila kosong)
# 1. https://console.cloud.google.com/apis/credentials → OAuth client ID (Web)
# 2. Authorized redirect URI: <NEXT_PUBLIC_URL>/api/auth/google/callback
#    contoh lokal: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


